# .env.example
# Copy this file to .env and fill in your values.
# Development can fall back to local/mock data when AWS vars are blank.
# Production requires usable CloudWatch data or an explicitly disabled CloudWatch source plus local input.

# Compose defaults to production mode unless APP_ENV is set in .env.
# Use development only for a local trusted environment.
APP_ENV=development

# GenAI (Google Gemini)
GOOGLE_API_KEY=
GOOGLE_GENAI_MODEL=gemini-3.8-flash

# ---------------------------------------------------------------
# AWS CloudWatch integration (optional)
# Leave blank to use local/mock data as fallback automatically.
# ---------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
CLOUDWATCH_LOG_GROUP=CloudTrail/DefaultLogGroup

# ---------------------------------------------------------------
# Severity alerting (optional)
# Generic webhook (Slack / MS Teams / PagerDuty) for severity alerts.
# Leave blank to disable. Tune tier in config/alerts.yaml.
# ---------------------------------------------------------------
ALERT_WEBHOOK_URL=

# ---------------------------------------------------------------
# Dashboard RBAC — required in production. Development defaults are local-only.
# ---------------------------------------------------------------
DASH_PASS_OPERATOR=
DASH_PASS_ANALYST=
DASH_PASS_EXECUTIVE=
DASH_PASS_ADMIN=

# ---------------------------------------------------------------
# API auth: bearer token required for all data routes in production.
# Development mode allows access without a key; health remains public.
# ---------------------------------------------------------------
API_KEY=
