# .env.example
# Copy this file to .env and fill in your values.
# The system will automatically fall back to local/mock data if AWS vars are blank.

# GenAI (Google Gemini)
GOOGLE_API_KEY=

# ---------------------------------------------------------------
# AWS CloudWatch integration (optional)
# Leave blank to use local/mock data as fallback automatically.
# ---------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
CLOUDWATCH_LOG_GROUP=CloudTrail/DefaultLogGroup
